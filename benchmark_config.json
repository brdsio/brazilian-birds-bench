    "anthropic/claude-opus-4.8",
    "anthropic/claude-sonnet-4.6",
    "openai/gpt-5.5",
    "openai/gpt-5.4-mini",
    "deepseek/deepseek-v4-pro",
    "moonshotai/kimi-k2.6",
    "mistralai/mistral-small-2603",
    "qwen/qwen3.7-plus"
  ],
  "reasoning_by_model": {
    "google/gemini-3.1-flash-lite": {
      "effort": "medium",
      "exclude": true
    },
    "anthropic/claude-opus-4.8": {
      "enabled": true,
      "max_tokens": 1024,
      "exclude": true
    },
    "anthropic/claude-sonnet-4.6": {
      "enabled": true,
      "max_tokens": 1024,
      "exclude": true
    },
    "openai/gpt-5.5": {
      "effort": "medium",
      "exclude": true
    },
