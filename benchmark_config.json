    "deepseek/deepseek-v4-pro": {
      "effort": "high",
      "exclude": true
    },
    "moonshotai/kimi-k2.6": {
      "enabled": true,
      "exclude": true
    },
    "mistralai/mistral-small-2603": {
      "effort": "high",
      "exclude": true
    },
    "qwen/qwen3.7-plus": {
      "enabled": true,
      "exclude": true
    }
  },
  "reasoning_groups": {
    "effort_medium": [
      "google/gemini-3.1-flash-lite",
      "openai/gpt-5.5",
      "openai/gpt-5.4-mini"
    ],
    "fixed_budget_256": [
      "anthropic/claude-opus-4.8",
      "anthropic/claude-sonnet-4.6"
    ],
    "nearest_available_high": [
